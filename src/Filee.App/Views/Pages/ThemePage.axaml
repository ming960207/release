<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:c="using:Filee.App.Controls"
             x:Class="Filee.App.Views.Pages.ThemePage"
             x:DataType="vm:ThemePageViewModel">
  <Grid ColumnDefinitions="*,20,340" RowDefinitions="Auto,*">
    <TextBlock Grid.ColumnSpan="3" Classes="h1" Text="{DynamicResource theme.title}" Margin="0,0,0,18" />

    <StackPanel Grid.Row="1" Spacing="16">
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="label" Text="{DynamicResource theme.mode}" />
          <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" MinWidth="220" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="label" Text="{DynamicResource theme.accent}" />
          <ListBox x:Name="AccentSwatches" ItemsSource="{Binding Swatches}" SelectedItem="{Binding Accent, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   AutomationProperties.Name="{DynamicResource theme.accent}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="4" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Template">
                  <ControlTemplate>
                    <Border x:Name="SelectionRing" CornerRadius="999" BorderThickness="2" BorderBrush="Transparent" Padding="3">
                      <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                  </ControlTemplate>
                </Setter>
              </Style>
              <Style Selector="ListBoxItem:selected /template/ Border#SelectionRing">
                <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
              </Style>
              <Style Selector="ListBoxItem:focus-visible /template/ Border#SelectionRing">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="Color">
                <Border Width="34" Height="34" CornerRadius="999" ToolTip.Tip="{Binding}" AutomationProperties.Name="{Binding}">
                  <Border.Background>
                    <SolidColorBrush Color="{Binding}" />
                  </Border.Background>
                  <PathIcon Data="{StaticResource Icon.Check}" Width="16" Height="16"
                            Foreground="{DynamicResource OnAccentBrush}"
                            IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="label" VerticalAlignment="Center" Text="{DynamicResource theme.custom_color}" Margin="0" />
            <ColorPicker x:Name="AccentPicker" Color="{Binding Accent, Mode=TwoWay}" IsAlphaEnabled="False"
                         MinHeight="44" MinWidth="90"
                         IsAlphaVisible="False" IsColorSpectrumVisible="True" IsColorPaletteVisible="False"
                         IsColorComponentsVisible="False" IsColorModelVisible="False" IsColorPreviewVisible="True"
                         FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource theme.custom_color}" />
            <TextBox Text="{Binding AccentHex}" Width="120" PlaceholderText="#7F77DD" FlowDirection="LeftToRight"
                     AutomationProperties.Name="{DynamicResource theme.custom_color}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding CornerRadius, StringFormat={}{0:0}}" />
            <TextBlock Classes="label" Text="{DynamicResource theme.corner_radius}" />
          </DockPanel>
          <Slider Minimum="0" Maximum="28" Value="{Binding CornerRadius}" TickFrequency="1" IsSnapToTickEnabled="True" />
        </StackPanel>
      </Border>

      <!-- The donut toolbar's opacity: the same setting as Donut toolbar → Appearance → Opacity. -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding DonutOpacity, StringFormat={}{0:0}%}" />
            <TextBlock Classes="label" Text="{DynamicResource theme.donut_opacity}" />
          </DockPanel>
          <Slider x:Name="DonutOpacitySlider" Minimum="10" Maximum="100" Value="{Binding DonutOpacity}"
                  TickFrequency="1" IsSnapToTickEnabled="True" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="4">
          <CheckBox Content="{DynamicResource theme.reduce_motion}" IsChecked="{Binding ReduceMotion}" FontWeight="SemiBold" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource theme.reduce_motion_hint}" Margin="28,0,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Live preview -->
    <Border Grid.Row="1" Grid.Column="2" Classes="card" VerticalAlignment="Top">
      <StackPanel Spacing="14">
        <TextBlock Classes="label" Text="{DynamicResource theme.preview}" />
        <!-- The donut over a stand-in for the desktop, so its opacity shows. -->
        <Border Background="{Binding PreviewBackdrop}" CornerRadius="{DynamicResource SoftRadiusLarge}" Padding="0,10" ClipToBounds="True">
          <c:DonutMenu x:Name="PreviewDonut" Items="{Binding PreviewItems}" OuterRadius="120" CenterTitle="JPG × 3" HorizontalAlignment="Center"
                       SliceOpacity="{Binding DonutOpacity, Converter={x:Static vm:ToolbarConverters.Percent}}" />
        </Border>
        <!-- Samples of the accent on controls: pictures only, so they don't pass for settings. -->
        <StackPanel Spacing="14" IsHitTestVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Classes="accent" Content="{DynamicResource common.save}" Focusable="False" />
            <Button Content="{DynamicResource common.cancel}" Focusable="False" />
          </StackPanel>
          <ToggleSwitch IsChecked="True" HorizontalAlignment="Center" Focusable="False" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
